
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>The Dot Cafe | Breakfast & Lunch in Ames, Iowa</title>

  <meta name="description"
    content="Visit The Dot Cafe in West Ames, Iowa for breakfast and lunch, creative comfort food, local ingredients, and a welcoming atmosphere.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,600;1,700&display=swap"
    rel="stylesheet">

  <style>
    :root {
      --cream: #fffaf1;
      --cream-dark: #f7eddf;
      --green: #344a36;
      --green-dark: #243527;
      --sage: #a8b59a;
      --pink: #edc5b9;
      --peach: #f4dbcd;
      --rose: #a66e60;
      --text: #2e372d;
      --white: #ffffff;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text);
      line-height: 1.65;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .container {
      width: min(1180px, 90%);
      margin: auto;
    }

    /* NAVIGATION */

    header {
      background: var(--cream);
      border-bottom: 1px solid #e7ded1;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .navbar {
      min-height: 95px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
    }

    .logo {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .logo img {
      width: 150px;
      height: 75px;
      object-fit: contain;
      mix-blend-mode: multiply;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      font-size: 15px;
      font-weight: 700;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--rose);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 15px 27px;
      border-radius: 40px;
      font-size: 15px;
      font-weight: 800;
      transition: 0.25s ease;
      text-align: center;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--green);
      color: white;
    }

    .btn-primary:hover {
      background: var(--green-dark);
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 1px solid var(--sage);
      color: var(--green);
      background: var(--cream);
    }

    .btn-outline:hover {
      background: var(--peach);
    }

    /* HERO SECTION */

    .hero {
      position: relative;
      overflow: hidden;
      padding: 90px 0 100px;
      background: linear-gradient(
        135deg,
        #fffaf1 0%,
        #fcf0e5 100%
      );
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 370px;
      height: 520px;
      background: var(--pink);
      opacity: 0.75;
      border-radius: 50%;
      left: -260px;
      top: 50px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px;
      align-items: center;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #687962;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 25px;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', serif;
      line-height: 1.15;
    }

    h1 {
      font-size: clamp(48px, 5.3vw, 80px);
      font-weight: 800;
      letter-spacing: -2px;
      margin-bottom: 28px;
    }

    h1 em {
      color: var(--rose);
      font-weight: 700;
    }

    .hero-description {
      font-size: 19px;
      line-height: 1.9;
      max-width: 520px;
      margin-bottom: 35px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
    }

    .hero-image {
      position: relative;
      min-width: 0;
    }

    .hero-photo {
      width: 100%;
      aspect-ratio: 4 / 4.5;
      object-fit: cover;
      border-radius: 220px 220px 18px 18px;
      background: var(--peach);
    }

    .hero-image::before {
      content: "";
      position: absolute;
      width: 140px;
      height: 140px;
      background: var(--sage);
      border-radius: 50%;
      top: -25px;
      right: -28px;
      z-index: -1;
    }

    .hero-sticker {
      position: absolute;
      right: -25px;
      bottom: 35px;
      width: 150px;
      height: 150px;
      background: #eab5a6;
      color: var(--green-dark);
      border: 8px solid var(--cream);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.5;
      transform: rotate(12deg);
    }

    /* SECTIONS */

    section {
      scroll-margin-top: 105px;
    }

    .section {
      padding: 100px 0;
    }

    .section-label {
      color: var(--rose);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    h2 {
      font-size: clamp(35px, 4vw, 54px);
      margin-bottom: 25px;
    }

    .section-description {
      font-size: 18px;
      max-width: 750px;
      line-height: 1.9;
    }

    /* ABOUT SECTION */

    .about {
      background: #f1ddcf;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 80px;
    }

    .about-logo-box {
      min-height: 350px;
      background: #fff8ee;
      border-radius: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 45px;
      position: relative;
    }

    .about-logo-box::after {
      content: "GOOD FOOD, GOOD COMPANY";
      position: absolute;
      bottom: 26px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--rose);
    }

    .about-logo-box img {
      width: 100%;
      max-width: 350px;
      mix-blend-mode: multiply;
    }

    .about p {
      font-size: 17px;
      margin-bottom: 20px;
      line-height: 1.9;
    }

    /* WHY VISIT */

    .why-visit {
      text-align: center;
    }

    .why-visit .section-description {
      margin: 0 auto 50px;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .feature-card {
      padding: 40px 30px;
      background: #ffffff;
      border: 1px solid #eaddce;
      border-radius: 18px;
      text-align: left;
    }

    .feature-icon {
      font-size: 36px;
      margin-bottom: 22px;
    }

    .feature-card h3 {
      font-size: 24px;
      margin-bottom: 15px;
    }

    .feature-card p {
      color: #596459;
      font-size: 15px;
    }

    /* SEMESTER PROJECT */

    .project {
      background: #e7ebdd;
    }

    .project-intro {
      max-width: 850px;
      margin-bottom: 45px;
    }

    .project-intro p {
      font-size: 17px;
      line-height: 1.9;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .project-card {
      background: var(--cream);
      padding: 36px;
      border-radius: 18px;
      border: 1px solid #d7dfce;
    }

    .project-card span {
      color: var(--rose);
      text-transform: uppercase;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .project-card h3 {
      font-size: 26px;
      margin: 15px 0;
    }

    .project-card p {
      font-size: 15px;
      line-height: 1.9;
    }

    .project-note {
      margin-top: 30px;
      color: #526551;
      font-style: italic;
      font-size: 14px;
    }

    /* VISIT SECTION */

    .visit {
      background: var(--cream);
    }

    .visit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px;
      align-items: start;
    }

    .visit-details {
      background: var(--peach);
      padding: 40px;
      border-radius: 20px;
    }

    .detail-block {
      margin-bottom: 30px;
    }

    .detail-block:last-child {
      margin-bottom: 0;
    }

    .detail-block h3 {
      font-family: 'DM Sans', sans-serif;
      font-size: 16px;
      margin-bottom: 10px;
      color: var(--green);
    }

    .detail-block p {
      font-size: 17px;
    }

    .visit-actions {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    /* FOOTER */

    footer {
      background: var(--green-dark);
      color: #fffaf1;
      padding: 50px 0 25px;
    }

    .footer-grid {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      padding-bottom: 35px;
    }

    .footer-title {
      font-family: 'Playfair Display', serif;
      font-size: 33px;
      font-weight: 800;
    }

    .footer-subtitle {
      font-size: 14px;
      color: #d5dfd2;
      margin-top: 10px;
    }

    .footer-links {
      display: flex;
      gap: 25px;
      flex-wrap: wrap;
      font-size: 14px;
      font-weight: 700;
    }

    .footer-links a:hover {
      color: var(--pink);
    }

    .footer-bottom {
      border-top: 1px solid #566956;
      padding-top: 22px;
      color: #bdcbb9;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .navbar {
        flex-wrap: wrap;
        justify-content: center;
        padding: 12px 0;
      }

      .nav-links {
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
      }

      .hero-grid,
      .about-grid,
      .visit-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 70px 0;
      }

      .hero-image {
        max-width: 570px;
        margin: 15px auto 0;
        width: 100%;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .project-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 560px) {
      h1 {
        font-size: 45px;
      }

      .hero-description {
        font-size: 17px;
      }

      .section {
        padding: 70px 0;
      }

      .hero-sticker {
        width: 115px;
        height: 115px;
        font-size: 12px;
        right: -8px;
      }

      .visit-details,
      .project-card {
        padding: 25px;
      }

      .hero-buttons,
      .visit-actions {
        flex-direction: column;
      }

      .hero-buttons .btn,
      .visit-actions .btn {
        width: 100%;
      }

      .navbar > .btn {
        display: none;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->

  <header>
    <div class="container navbar">

      <a class="logo" href="#home" aria-label="The Dot Cafe Home">
        <img
          src="https://images.squarespace-cdn.com/content/v1/66e49fd9f712f62c511c2847/9b5f986d-b02f-465c-a775-2c6c71348a8e/_DSC7067.jpg"
          alt="The Dot Cafe"
          onerror="this.style.display='none';this.parentElement.textContent='The Dot Cafe';">
      </a>

      <nav aria-label="Main navigation">
        <ul class="nav-links">
          <li><a href="#home">Home</a></li>
          <li><a href="#about">Our Story</a></li>
          <li><a href="#project">Semester Project</a></li>
          <li><a href="#visit">Visit Us</a></li>
        </ul>
      </nav>

      <a class="btn btn-primary"
         href="https://www.thedotames.com/"
         target="_blank"
         rel="noopener noreferrer">
         Explore Menu ↗
      </a>

    </div>
  </header>

  <!-- HERO -->

  <main>

    <section class="hero" id="home">

      <div class="container hero-grid">

        <div class="hero-content">

          <div class="eyebrow">
            ✳ A LITTLE SOMETHING SPECIAL IN WEST AMES
          </div>

          <h1>
            Good food.<br>
            Good company.<br>
            <em>Good mornings.</em>
          </h1>

          <p class="hero-description">
            Breakfast and lunch served all day, with
            familiar favorites, creative twists, and
            a cozy neighborhood atmosphere.
          </p>

          <div class="hero-buttons">

            <a class="btn btn-primary"
               href="https://www.thedotames.com/"
               target="_blank"
               rel="noopener noreferrer">
              Explore the Menu →
            </a>

            <a class="btn btn-outline" href="#visit">
              Plan Your Visit
            </a>

          </div>

        </div>

        <div class="hero-image">

          <img
            class="hero-photo"
            src="https://images.squarespace-cdn.com/content/v1/66e49fd9f712f62c511c2847/9b5f986d-b02f-465c-a775-2c6c71348a8e/_DSC7067.jpg"
            alt="Food and atmosphere at The Dot Cafe"
            loading="eager">

          <div class="hero-sticker">
            BREAKFAST<br>
            + LUNCH<br>
            ALL DAY!
          </div>

        </div>

      </div>

    </section>

    <!-- ABOUT -->

    <section class="section about" id="about">

      <div class="container about-grid">

        <div class="about-logo-box">

          <img
            src="https://images.squarespace-cdn.com/content/v1/66e49fd9f712f62c511c2847/9b5f986d-b02f-465c-a775-2c6c71348a8e/_DSC7067.jpg"
            alt="The Dot Cafe logo">

        </div>

        <div>

          <div class="section-label">Our Story</div>

          <h2>A little nostalgia.<br>A lot of heart.</h2>

          <p>
            Welcome to The Dot, a cozy neighborhood café
            located in West Ames, Iowa.
          </p>

          <p>
            As a woman-owned small business, The Dot brings
            together nostalgic comfort food and modern
            culinary creativity.
          </p>

          <p>
            By partnering with local businesses and using
            fresh ingredients, The Dot offers a welcoming
            place for friends, families, and the Ames
            community to connect over good food.
          </p>

          <a class="btn btn-primary" href="#visit">
            Come Visit Us →
          </a>

        </div>

      </div>

    </section>

    <!-- FEATURES -->

    <section class="section why-visit">

      <div class="container">

        <div class="section-label">Why The Dot?</div>

        <h2>More than just a café.</h2>

        <p class="section-description">
          Whether you're grabbing breakfast before class,
          meeting friends for lunch, or exploring a new
          local spot, The Dot offers something special.
        </p>

        <div class="feature-grid">

          <div class="feature-card">
            <div class="feature-icon">☕</div>
            <h3>Cozy Atmosphere</h3>
            <p>
              A warm and welcoming space where you can
              enjoy good food and great company.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🥐</div>
            <h3>Breakfast & Lunch</h3>
            <p>
              Enjoy nostalgic favorites with creative
              twists throughout the café's serving hours.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">🌿</div>
            <h3>Locally Connected</h3>
            <p>
              Supporting local businesses while serving
              fresh ingredients to the Ames community.
            </p>
          </div>

        </div>

      </div>

    </section>

    <!-- SEMESTER PROJECT -->

    <section class="section project" id="project">

      <div class="container">

        <div class="section-label">
          Iowa State University Marketing Project
        </div>

        <h2>Our Semester Project</h2>

        <div class="project-intro">

          <p>
            Throughout the semester, our marketing group
            has analyzed The Dot Cafe's digital presence
            and explored opportunities to improve its
            website and online marketing strategy.
          </p>

          <p>
            Our goal is to create a more user-friendly
            experience, improve online visibility, and
            encourage more customers to discover and
            visit The Dot Cafe.
          </p>

        </div>

        <div class="project-grid">

          <div class="project-card">

            <span>01 — Website Audit</span>

            <h3>Evaluating the Website</h3>

            <p>
              Our group conducted a website audit
              focusing on user interface, user experience,
              search engine optimization, and website
              performance.
            </p>

            <p>
              We evaluated the Home, Menu, About,
              and Contact pages to identify strengths
              and opportunities for improvement.
            </p>

          </div>

          <div class="project-card">

            <span>02 — Key Findings</span>

            <h3>Identifying Improvements</h3>

            <p>
              Our audit identified opportunities to improve
              text readability, navigation, menu
              organization, calls to action, and
              search engine optimization.
            </p>

            <p>
              These findings guided our homepage redesign
              and digital marketing recommendations.
            </p>

          </div>

          <div class="project-card">

            <span>03 — Website Redesign</span>

            <h3>Improving User Experience</h3>

            <p>
              We redesigned the homepage to provide
              clearer navigation, more visible buttons,
              improved text contrast, and easier
              access to café information.
            </p>

            <p>
              The updated website maintains The Dot's
              welcoming and nostalgic brand identity.
            </p>

          </div>

          <div class="project-card">

            <span>04 — Display Advertising</span>

            <h3>Promoting The Dot Cafe</h3>

            <p>
              Our group developed a display advertising
              campaign designed to increase brand
              awareness and encourage people to
              explore The Dot Cafe.
            </p>

            <p>
              The campaign includes audience targeting,
              advertising benchmarks, four display
              ad formats, and a dedicated landing page.
            </p>

          </div>

        </div>

        <p class="project-note">
          This executive summary will be updated as
          additional semester assignments are completed.
        </p>

      </div>

    </section>

    <!-- VISIT US -->

    <section class="section visit" id="visit">

      <div class="container visit-grid">

        <div>

          <div class="section-label">
            Come Say Hello
          </div>

          <h2>We'll save you<br>a seat.</h2>

          <p class="section-description">
            Looking for your next favorite breakfast
            or lunch spot in Ames? Stop by The Dot
            and enjoy the cozy atmosphere, creative
            dishes, and friendly community vibe.
          </p>

          <div class="visit-actions">

            <a class="btn btn-primary"
               href="https://www.google.com/maps/search/?api=1&query=127+Dotson+Drive+Ames+Iowa"
               target="_blank"
               rel="noopener noreferrer">
              Get Directions →
            </a>

            <a class="btn btn-outline"
               href="https://www.thedotames.com/"
               target="_blank"
               rel="noopener noreferrer">
              Explore the Menu
            </a>

          </div>

        </div>

        <div class="visit-details">

          <div class="detail-block">
            <h3>📍 LOCATION</h3>
            <p>
              127 Dotson Drive<br>
              Ames, Iowa 50014
            </p>
          </div>

          <div class="detail-block">
            <h3>🕒 HOURS</h3>
            <p>
              Wednesday – Sunday<br>
              8:00 AM – 2:00 PM
            </p>
            <p>Closed Monday & Tuesday</p>
          </div>

          <div class="detail-block">
            <h3>✉ CONTACT</h3>
            <p>
              <a href="mailto:thedotames@gmail.com">
                thedotames@gmail.com
              </a>
            </p>
            <p>
              <a href="tel:15154254188">
                (515) 425-4188
              </a>
            </p>
          </div>

        </div>

      </div>

    </section>

  </main>

  <!-- FOOTER -->

  <footer>

    <div class="container">

      <div class="footer-grid">

        <div>
          <div class="footer-title">The Dot Cafe</div>
          <p class="footer-subtitle">
            Good food. Good company. Good mornings.
          </p>
        </div>

        <div class="footer-links">
          <a href="#home">Home</a>
          <a href="#about">Our Story</a>
          <a href="#project">Semester Project</a>
          <a href="#visit">Visit Us</a>
        </div>

      </div>

      <div class="footer-bottom">
        <span>
          © 2026 The Dot Cafe — Student Marketing Project
        </span>
        <span>
          Website redesign concept for academic purposes.
        </span>
      </div>

    </div>

  </footer>

</body>
</html>
